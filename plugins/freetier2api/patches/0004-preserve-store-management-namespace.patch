--- /dev/null
+++ b/internal/app/store_namespace_test.go
@@ -0,0 +1,58 @@
+package app
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+
+	"freetier2api-plugin/cpasdk/pluginabi"
+	"freetier2api-plugin/cpasdk/pluginapi"
+)
+
+func TestStoreManagementNamespace(t *testing.T) {
+	instance := MustNew(Options{})
+	registration := instance.managementRegistration()
+	foundStatus := false
+	for _, route := range registration.Routes {
+		if !strings.HasPrefix(route.Path, "/plugins/freetier2api/") {
+			t.Fatalf("route outside the installed plugin namespace: %s", route.Path)
+		}
+		foundStatus = foundStatus || route.Path == "/plugins/freetier2api/status"
+	}
+	if !foundStatus {
+		t.Fatal("status route missing")
+	}
+	if len(registration.Resources) != 1 || registration.Resources[0].Path != "/console" {
+		t.Fatalf("console resource: %+v", registration.Resources)
+	}
+	request, err := json.Marshal(pluginapi.ManagementRequest{
+		Method: http.MethodGet, Path: "/v0/resource/plugins/freetier2api/console",
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := instance.HandleMethod(pluginabi.MethodManagementHandle, request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var envelope struct {
+		OK     bool                         `json:"ok"`
+		Result pluginapi.ManagementResponse `json:"result"`
+	}
+	if err := json.Unmarshal(raw, &envelope); err != nil {
+		t.Fatal(err)
+	}
+	if !envelope.OK || envelope.Result.StatusCode != http.StatusOK {
+		t.Fatalf("store console: %s", raw)
+	}
+	if !strings.Contains(string(envelope.Result.Body), `var BASE = "/plugins/freetier2api";`) {
+		t.Fatal("console uses the wrong management API prefix")
+	}
+	if !strings.Contains(string(envelope.Result.Body), `hostPath(BASE + "/config")`) {
+		t.Fatal("console config calls must use the installed management namespace")
+	}
+	if providerKey != "freetier" {
+		t.Fatalf("existing credential provider changed: %q", providerKey)
+	}
+}
