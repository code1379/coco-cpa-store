+func (c *Catalog) reloadEnabledWith(items []string) {
+	enabled := make(map[string]bool, len(items)*2)
+	for _, item := range items {
+		for _, key := range c.ExpandKeys(item) {
+			if key != "" { enabled[key] = true }
+		}
+	}
+	c.mu.Lock()
+	c.enabled = enabled
+	c.mu.Unlock()
+}
