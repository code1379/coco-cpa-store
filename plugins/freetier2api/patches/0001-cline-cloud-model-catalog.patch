diff --git a/internal/vendors/cline/adapter.go b/internal/vendors/cline/adapter.go
--- a/internal/vendors/cline/adapter.go
+++ b/internal/vendors/cline/adapter.go
@@ -143,10 +143,12 @@ func describeModel(model Model) string {
