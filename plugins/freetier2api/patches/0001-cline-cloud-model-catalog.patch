+
+func TestParseModelsIncludesClineCloud(t *testing.T) {
+	models, err := parseModels([]byte(`{"free":[{"id":"cline-free/beam","name":"Beam"}],"clineCloud":[{"id":"cline-cloud/sonnet","name":"Sonnet"}]}`))
+	if err != nil { t.Fatal(err) }
+	if len(models) != 2 { t.Fatalf("model count = %d, want 2", len(models)) }
+	if models[0].Cost != CostFree || models[1].Cost != CostCloud {
+		t.Fatalf("model tiers = %q and %q, want free and cloud", models[0].Cost, models[1].Cost)
+	}
