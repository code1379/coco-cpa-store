 	case CostFree:
 		description = "[免费] " + description
 	case CostPass:
 		description = "[订阅] " + description
+	case CostCloud:
+		description = "[Cline Cloud] " + description
 	}
 	if model.IsReasoning {
 		description += "（推理）"
@@ -166,8 +166,10 @@ func costLabel(cost string) string {
 	switch cost {
 	case CostFree:
 		return "免费"
 	case CostPass:
 		return "订阅"
+	case CostCloud:
+		return "Cline Cloud"
 	}
 	return ""
 }
