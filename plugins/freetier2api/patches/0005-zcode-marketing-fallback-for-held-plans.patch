+// 如果为了寻找尚未持有的营销活动而触发了兜底查询，且兜底失败，就必须保留错误。
+func resolveClaimableOffers(offered []core.PlanInfo, errPreview error, marketing []core.PlanInfo, errMarketing error, held map[string]bool) ([]core.PlanInfo, error) {
+	merged, err := resolveOffers(offered, errPreview, marketing, errMarketing)
+	if !hasClaimableOffer(merged, held) {
+		if errPreview != nil {
+			return merged, errPreview
+		}
+		if errMarketing != nil {
+			return merged, errMarketing
+		}
+	}
+	return merged, err
+}
 
