+func TestNeedsMarketingFallback(t *testing.T) {
+	previewErr := core.NewPluginError("zcode_preview_http", "preview 429", 502)
+	tests := []struct {
+		name       string
+		offered    []core.PlanInfo
+		held       map[string]bool
+		previewErr error
+		want       bool
+	}{
+		{name: "empty billing preview", want: true},
+		{name: "all billing offers already held", offered: []core.PlanInfo{{PlanID: "daily"}}, held: map[string]bool{"daily": true}, want: true},
+		{name: "billing has a claimable offer", offered: []core.PlanInfo{{PlanID: "daily"}, {PlanID: "weekly"}}, held: map[string]bool{"daily": true}, want: false},
+		{name: "billing preview failed", offered: []core.PlanInfo{{PlanID: "daily"}}, previewErr: previewErr, want: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := needsMarketingFallback(tt.offered, tt.held, tt.previewErr); got != tt.want {
+				t.Fatalf("needsMarketingFallback() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
