+// hasClaimableOffer 报告投放列表里是否至少有一个尚未持有的套餐。
+func hasClaimableOffer(offered []core.PlanInfo, held map[string]bool) bool {
+	for _, plan := range offered {
+		if !held[plan.PlanID] {
+			return true
+		}
+	}
+	return false
+}
+
+// needsMarketingFallback 在计费通道没有可领取套餐时查询营销通道。
+func needsMarketingFallback(offered []core.PlanInfo, held map[string]bool, previewErr error) bool {
+	return previewErr != nil || !hasClaimableOffer(offered, held)
+}
