+func TestResolveClaimableOffers(t *testing.T) {
+	held := map[string]bool{"daily": true}
+	marketingErr := core.NewPluginError("zcode_activity_http", "marketing 429", 429)
+
+	t.Run("held billing offer does not hide marketing error", func(t *testing.T) {
+		offers, err := resolveClaimableOffers([]core.PlanInfo{{PlanID: "daily"}}, nil, nil, marketingErr, held)
+		if len(offers) != 1 || err != marketingErr {
+			t.Fatalf("offers=%v err=%v, want held offer plus marketing error", offers, err)
+		}
+	})
+	t.Run("marketing offer supplements held billing offer", func(t *testing.T) {
+		offers, err := resolveClaimableOffers([]core.PlanInfo{{PlanID: "daily"}}, nil,
+			[]core.PlanInfo{{PlanID: "campaign"}}, nil, held)
+		if err != nil || !hasClaimableOffer(offers, held) {
+			t.Fatalf("offers=%v err=%v, want an unheld marketing offer", offers, err)
+		}
+	})
+	t.Run("claimable billing offer survives marketing error", func(t *testing.T) {
+		offers, err := resolveClaimableOffers([]core.PlanInfo{{PlanID: "weekly"}}, nil, nil, marketingErr, map[string]bool{})
